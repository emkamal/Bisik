<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuse the application's credential-redacting logger without coupling builds to its executable. -->
    <Compile Include="../../src/Core/ErrorLogger.cs" Link="ErrorLogger.cs" />
  </ItemGroup>
</Project>
